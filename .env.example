# Pastelada - Variáveis de Ambiente & Inventário de Chaves
# Copie este arquivo para .env em ambiente de desenvolvimento local

# URL pública da aplicação
APP_URL="http://localhost:3000"

# IA Studio Gemini API Key
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Pagamentos - Mercado Pago (PIX e Cartão)
# Obtenha em: mercadopago.com.br/developers/panel/app
MERCADO_PAGO_ACCESS_TOKEN="TEST-0000000000000000-000000-00000000000000000000000000000000-000000000"
MERCADO_PAGO_PUBLIC_KEY="TEST-00000000-0000-0000-0000-000000000000"
MERCADO_PAGO_WEBHOOK_SECRET="whsec_00000000000000000000000000000000"

# E-mail Transacional - Resend
# Obtenha em: resend.com/api-keys
RESEND_API_KEY="re_00000000_000000000000000000000000"
EMAIL_FROM="pedidos@example.com"

# Google Cloud OAuth 2.0 (Login de Clientes e Dono)
# Obtenha em: console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"

# Chave mestra do servidor para criptografia AES-256-GCM em repouso
APP_MASTER_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Banco de Dados PostgreSQL (se full-stack backend)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/pastelada_db?sslmode=require"
